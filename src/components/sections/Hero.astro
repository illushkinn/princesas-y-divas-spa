---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Hero Section
 * ─────────────────────────────────────────────
 * Full-viewport hero con gradiente rose-gold → lavender,
 * headline impactante y CTA a WhatsApp.
 */

import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { SITE_CONFIG } from "../../data/site-config";

const waLink = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(
  "¡Hola! Quiero reservar un día de spa para mi hija. ¿Me dan más información?"
)}`;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  aria-label="Hero principal"
>
  <!-- Background gradient (decorative) -->
  <div class="absolute inset-0 bg-gradient-to-br from-rose-gold via-rose-gold-light to-lavender-light"></div>
  <!-- Dark overlay for WCAG AA contrast — text-white works over this -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-10" aria-hidden="true">
    <div class="absolute top-10 left-10 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-48 h-48 bg-lavender/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 w-24 h-24 bg-gold/10 rounded-full blur-2xl"></div>
    <!-- Sparkle icons -->
    <Icon name="sparkle" class="absolute top-20 right-[15%] w-6 h-6 text-gold/40" />
    <Icon name="sparkle" class="absolute bottom-1/4 left-[10%] w-4 h-4 text-white/40" />
    <Icon name="sparkle" class="absolute top-[30%] left-[20%] w-5 h-5 text-gold/30" />
  </div>

  <!-- Content -->
  <div class="relative z-20 text-center px-4 sm:px-6 max-w-4xl mx-auto animate-fade-in-up">
    <!-- Logo del spa como imagen de marca -->
    <div class="mb-6 flex justify-center" aria-hidden="true">
      <img
        src="/images/logo-spa.jpg"
        alt="Princesas & Divinas — Logo"
        class="w-28 h-28 sm:w-36 sm:h-36 rounded-full object-cover border-4 border-white/40 shadow-xl ring-2 ring-white/20"
        width="144"
        height="144"
        loading="eager"
        decoding="async"
      />
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-white mb-6 leading-tight drop-shadow-lg">
      El spa infantil<br />
      <span class="text-white font-bold">más mágico de CABA</span>
    </h1>

    <p class="text-lg sm:text-xl md:text-2xl text-white/90 mb-10 max-w-2xl mx-auto leading-relaxed">
      Maquillaje, peinados con glitter, uñas decoradas y fiestas de princesa.
      <span class="block mt-2 font-semibold">
        Una experiencia inolvidable para tu hija y sus amigas.
      </span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button
        variant="whatsapp"
        size="lg"
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        ariaLabel="Reservá por WhatsApp — abre WhatsApp"
        className="text-lg px-10 py-4 shadow-2xl"
      >
        <Icon name="whatsapp-logo" weight="fill" size="1.5em" />
        Reservá por WhatsApp
      </Button>

      <Button
        variant="secondary"
        size="lg"
        href="#servicios"
        ariaLabel="Ver servicios"
        className="text-lg px-8 py-4 border-white/60 text-white hover:bg-white/10"
      >
        Ver servicios
      </Button>
    </div>

    <!-- Badge de confianza -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-8 text-white/80 text-sm">
      <span class="flex items-center gap-1">
        <Icon name="map-pin" class="text-white/80" />
        {SITE_CONFIG.address.full}
      </span>
      <span class="flex items-center gap-1">
        <Icon name="star" class="text-white/80" />
        {SITE_CONFIG.rating} — 30+ reseñas
      </span>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
