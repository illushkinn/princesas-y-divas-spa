---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Hero Section
 * ─────────────────────────────────────────────
 * Full-viewport hero con gradiente rosa-lavanda,
 * headline impactante y CTA a WhatsApp.
 */

import Button from "../ui/Button.astro";
import { SITE_CONFIG } from "../../data/site-config";

const waLink = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(
  "¡Hola! 😊 Quiero reservar un día de spa para mi hija. ¿Me dan más información?"
)}`;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-rosa via-rosa-light to-lavanda-light"
  aria-label="Hero principal"
>
  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-10 left-10 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-48 h-48 bg-lavanda/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 w-24 h-24 bg-dorado/10 rounded-full blur-2xl"></div>
    <!-- Sparkle dots -->
    <svg class="absolute top-20 right-[15%] w-6 h-6 text-dorado/40" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0l1.5 9.5L23 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/>
    </svg>
    <svg class="absolute bottom-1/4 left-[10%] w-4 h-4 text-white/40" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0l1.5 9.5L23 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/>
    </svg>
    <svg class="absolute top-[30%] left-[20%] w-5 h-5 text-dorado/30" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0l1.5 9.5L23 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5z"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 max-w-4xl mx-auto animate-fade-in-up">
    <!-- Icono corona -->
    <div class="mb-6" aria-hidden="true">
      <span class="text-6xl sm:text-7xl">👑</span>
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-white mb-6 leading-tight drop-shadow-lg">
      El spa infantil<br />
      <span class="text-dorado-light">más mágico de CABA</span>
    </h1>

    <p class="text-lg sm:text-xl md:text-2xl text-white/90 mb-10 max-w-2xl mx-auto leading-relaxed">
      Maquillaje, peinados con glitter, uñas decoradas y fiestas de princesa.
      <span class="block mt-2 font-semibold">
        Una experiencia inolvidable para tu hija y sus amigas.
      </span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button
        variant="whatsapp"
        size="lg"
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        ariaLabel="Reservá por WhatsApp — abre WhatsApp"
        className="text-lg px-10 py-4 shadow-2xl"
      >
        <!-- Ícono WhatsApp -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        Reservá por WhatsApp
      </Button>

      <Button
        variant="secondary"
        size="lg"
        href="#servicios"
        ariaLabel="Ver servicios"
        className="text-lg px-8 py-4 border-white/60 text-white hover:bg-white/10"
      >
        Ver servicios
      </Button>
    </div>

    <!-- Badge de confianza -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-8 text-white/80 text-sm">
      <span class="flex items-center gap-1">
        <span aria-hidden="true">📍</span>
        {SITE_CONFIG.address.full}
      </span>
      <span class="flex items-center gap-1">
        <span aria-hidden="true">⭐</span>
        {SITE_CONFIG.rating} — 30+ reseñas
      </span>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
