---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Testimonios Section
 * ─────────────────────────────────────────────
 * En mobile: scroll horizontal (carousel CSS).
 * En desktop: grid de 3 columnas.
 *
 * ⚠️ NO se usa JS — el "carousel" es CSS scroll snap.
 */

import Icon from "../ui/Icon.astro";
import { TESTIMONIALS } from "../../data/testimonials";
---

<section
  id="testimonios"
  class="py-16 sm:py-20 lg:py-24 bg-cream"
  aria-label="Testimonios de clientas"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 sm:mb-16">
      <Icon name="chat-circle" size="3em" class="block mb-4 mx-auto text-rose-gold-dark" aria-hidden="true" />
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-text-primary mb-4">
        Lo que dicen las mamás
      </h2>
      <p class="text-lg sm:text-xl text-text-secondary max-w-2xl mx-auto">
        Más de 30 familias ya vivieron la experiencia. Esto es lo que opinan.
      </p>
    </div>

    <!-- Mobile: scroll horizontal (CSS carousel) -->
    <div
      class="flex md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 overflow-x-auto snap-x snap-mandatory pb-4 md:pb-0 md:overflow-visible scroll-pl-4"
      role="list"
      aria-label="Lista de testimonios"
    >
      {
        TESTIMONIALS.map((t) => (
          <article
            class="snap-start shrink-0 w-[85vw] md:w-auto md:shrink bg-white rounded-2xl p-6 shadow-md border border-cream-dark flex flex-col"
            role="listitem"
          >
            <!-- Header: foto + nombre + rating -->
            <div class="flex items-center gap-4 mb-4">
              <img
                src={t.photo}
                alt={`Foto de ${t.name}`}
                class="w-12 h-12 rounded-full object-cover border-2 border-rose-gold-light"
                loading="lazy"
                width={48}
                height={48}
              />
              <div>
                <h3 class="font-bold text-text-primary">{t.name}</h3>
                {t.service && (
                  <p class="text-xs text-rose-gold-dark">{t.service}</p>
                )}
              </div>
            </div>

            <!-- Rating — estrellas en rose-gold-dark (NUNCA gold sobre fondo claro) -->
            <div class="mb-3 flex gap-0.5" aria-label={`${t.rating} de 5 estrellas`}>
              {Array.from({ length: 5 }, (_, i) => (
                <Icon
                  key={i}
                  name={i < t.rating ? "star" : "star-four"}
                  size="1em"
                  class={i < t.rating ? "text-rose-gold-dark" : "text-cream-dark"}
                />
              ))}
            </div>

            <!-- Texto -->
            <blockquote class="text-text-secondary leading-relaxed flex-1">
              <p class="italic">
                <span class="text-rose-gold-dark text-lg leading-none" aria-hidden="true">"</span>
                {t.text}
                <span class="text-rose-gold-dark text-lg leading-none" aria-hidden="true">"</span>
              </p>
            </blockquote>
          </article>
        ))
      }
    </div>

    <!-- Indicador de scroll (solo mobile) -->
    <div class="mt-6 text-center md:hidden">
      <span class="text-sm text-text-secondary">
        ← Deslizá para ver más →
      </span>
    </div>
  </div>
</section>
