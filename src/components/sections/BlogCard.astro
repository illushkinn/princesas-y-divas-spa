---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — BlogCard Component
 * ─────────────────────────────────────────────
 * Card para listado de blog posts con imagen,
 * categoría badge, título, extracto y fecha.
 */

import Card from "../ui/Card.astro";

export interface Props {
  title: string;
  slug: string;
  category: string;
  date: string;
  excerpt: string;
  coverImage?: string;
  author?: string;
}

const { title, slug, category, date, excerpt, coverImage, author } =
  Astro.props;

const categoryLabels: Record<string, string> = {
  tips: "💡 Tips",
  eventos: "🎉 Eventos",
  promociones: "🔥 Promos",
};

const categoryColors: Record<string, string> = {
  tips: "bg-lavanda/20 text-lavanda-dark",
  eventos: "bg-rosa/20 text-rosa-dark",
  promociones: "bg-dorado/20 text-dorado-dark",
};
---

<Card
  variant="blog"
  image={coverImage}
  imageAlt={title}
  badge={categoryLabels[category] || category}
  className="h-full flex flex-col"
>
  <div class="flex flex-col h-full">
    <!-- Fecha -->
    <time
      datetime={date}
      class="text-xs text-texto-secondary/60 mb-2"
    >
      {new Date(date).toLocaleDateString("es-AR", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>

    <!-- Título -->
    <h3 class="text-lg font-heading font-bold text-texto mb-2 line-clamp-2">
      <a
        href={`/blog/${slug}`}
        class="hover:text-rosa-dark transition-colors duration-200 no-underline"
        aria-label={`Leer más: ${title}`}
      >
        {title}
      </a>
    </h3>

    <!-- Extracto -->
    <p class="text-sm text-texto-secondary leading-relaxed mb-4 flex-1 line-clamp-3">
      {excerpt}
    </p>

    <!-- Footer card -->
    <div class="flex items-center justify-between pt-4 border-t border-crema-dark/50 mt-auto">
      {author && (
        <span class="text-xs text-texto-secondary/60">
          Por {author}
        </span>
      )}
      <a
        href={`/blog/${slug}`}
        class="text-sm font-semibold text-rosa-dark hover:text-rosa transition-colors duration-200 min-h-[44px] inline-flex items-center gap-1"
        aria-label={`Leer más sobre ${title}`}
      >
        Leer más
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Card>
