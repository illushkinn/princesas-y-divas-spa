---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — FAQ Section (Accordion)
 * ─────────────────────────────────────────────
 * Acordeón clásico con <details>/<summary>.
 * Cero JS — es HTML nativo.
 * Animación suave vía CSS transition.
 *
 * ✅ Incluye FAQ schema JSON-LD.
 */

import { FAQ } from "../../data/faq";
import { SITE_CONFIG } from "../../data/site-config";

// ── FAQ Schema JSON-LD ───────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 lg:py-24 bg-crema-dark/30"
  aria-label="Preguntas frecuentes"
>
  <!-- JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-4xl sm:text-5xl block mb-4" aria-hidden="true">❓</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-texto mb-4">
        Preguntas Frecuentes
      </h2>
      <p class="text-lg sm:text-xl text-texto-secondary max-w-2xl mx-auto">
        Todo lo que necesitás saber antes de reservar.
      </p>
    </div>

    <!-- Accordion list -->
    <div class="space-y-3">
      {
        FAQ.map((item) => (
          <details class="group bg-white rounded-xl shadow-sm border border-crema-dark overflow-hidden transition-shadow duration-300 hover:shadow-md open:shadow-md">
            <summary class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6 sm:py-5 cursor-pointer list-none min-h-[44px] font-semibold text-texto hover:text-rosa-dark transition-colors duration-200">
              <span class="text-base sm:text-lg pr-4">{item.question}</span>
              <span class="shrink-0 text-rosa-dark transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 sm:px-6 sm:pb-6 border-t border-crema-dark/50">
              <p class="mt-4 text-texto-secondary leading-relaxed">
                {item.answer}
              </p>
            </div>
          </details>
        ))
      }
    </div>

    <!-- CTA si no encontró respuesta -->
    <div class="text-center mt-10">
      <p class="text-texto-secondary mb-3">
        ¿Tenés otra consulta? Respondemos al toque por WhatsApp 💬
      </p>
      <a
        href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent("¡Hola! 😊 Tengo una consulta sobre los servicios de spa infantil...")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-whatsapp hover:text-whatsapp-dark font-bold transition-colors duration-200 min-h-[44px]"
        aria-label="Consultar por WhatsApp"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-5 h-5"
          aria-hidden="true"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        Escribinos por WhatsApp
      </a>
    </div>
  </div>
</section>

<!-- Smooth accordion animation -->
<style is:global>
  details .border-t {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  details[open] .border-t {
    grid-template-rows: 1fr;
  }
  details .border-t > * {
    overflow: hidden;
  }
</style>
