---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Blog / Post Individual
 * ─────────────────────────────────────────────
 * Página de post individual con:
 *   - Contenido formateado (Markdown → HTML)
 *   - Social share por WhatsApp
 *   - Article JSON-LD + BreadcrumbList
 *   - Navegación a post anterior/siguiente
 */

import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";
import { getCollection, getEntry, render } from "astro:content";
import { SITE_CONFIG } from "../../data/site-config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
  }));
}

const { slug } = Astro.params;

// Buscar el entry por ID (sin .md)
const post = await getEntry("blog", slug);

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);

const postUrl = `${SITE_CONFIG.url}/blog/${slug}`;

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE_CONFIG.name,
      item: SITE_CONFIG.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${SITE_CONFIG.url}/blog`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
    },
  ],
};

// Article JSON-LD
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.coverImage
    ? `${SITE_CONFIG.url}${post.data.coverImage}`
    : undefined,
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.author,
  },
  publisher: {
    "@type": "Organization",
    name: SITE_CONFIG.name,
  },
};

// WhatsApp share
const shareText = encodeURIComponent(
  `Mirá este artículo: ${post.data.title} — ${postUrl}`
);

const categoryLabels: Record<string, string> = {
  tips: "Tips",
  eventos: "Eventos",
  promociones: "Promos",
};
---

<Layout
  title={`${post.data.title} — Blog ${SITE_CONFIG.name}`}
  description={post.data.excerpt}
  ogImage={
    post.data.coverImage
      ? `${SITE_CONFIG.url}${post.data.coverImage}`
      : undefined
  }
>
  <!-- JSON-LD Schemas -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <!-- Post Header -->
  <div class="bg-gradient-to-r from-rose-gold-light via-lavender-light to-rose-gold-light py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="text-sm text-text-secondary/60 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-rose-gold-dark transition-colors">Inicio</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <a href="/blog" class="hover:text-rose-gold-dark transition-colors">Blog</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <span class="text-text-primary font-semibold">{post.data.title}</span>
      </nav>

      <!-- Category badge -->
      <span class="inline-block bg-white/60 text-text-primary text-sm font-semibold px-3 py-1 rounded-full mb-4">
        {categoryLabels[post.data.category] || post.data.category}
      </span>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-text-primary leading-tight mb-4">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-text-secondary/70">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("es-AR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <span aria-hidden="true">·</span>
        <span>Por {post.data.author}</span>
      </div>
    </div>
  </div>

  <!-- Post Content -->
  <div class="bg-cream py-8 sm:py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <!-- Cover image -->
      {post.data.coverImage && (
        <img
          src={post.data.coverImage}
          alt={post.data.title}
          class="w-full rounded-2xl shadow-lg mb-8"
          loading="eager"
          width={1200}
          height={630}
        />
      )}

      <!-- Content rendered from markdown -->
      <article class="prose prose-lg max-w-none">
        <Content />
      </article>

      <!-- Share & Navigation -->
      <div class="mt-12 pt-8 border-t border-cream-dark/50">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <!-- Compartir por WhatsApp -->
          <a
            href={`https://wa.me/?text=${shareText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-whatsapp text-white px-5 py-3 rounded-xl font-semibold shadow-md hover:bg-whatsapp-dark transition-all duration-200 min-h-[44px] no-underline"
            aria-label="Compartir este artículo por WhatsApp"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Compartir por WhatsApp
          </a>

          <!-- Volver -->
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-rose-gold-dark hover:text-rose-gold font-semibold transition-colors duration-200 min-h-[44px]"
          >
            <Icon name="arrow-left" />
            Volver al blog
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Prose styles -->
<style is:global>
  .prose h2 {
    font-family: 'Playfair Display', serif;
    color: #1A1A2E;
    font-size: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    font-family: 'Playfair Display', serif;
    color: #1A1A2E;
    font-size: 1.35rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    color: #4A4A5A;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .prose ul, .prose ol {
    color: #4A4A5A;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose a {
    color: #C0728F;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: #E8A0BF;
  }
  .prose img {
    border-radius: 1rem;
    margin: 1.5rem 0;
  }
  .prose blockquote {
    border-left: 4px solid #E8A0BF;
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #1A1A2E;
  }
  .prose hr {
    border-color: #F5E6D3;
    margin: 2rem 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .prose th {
    background: #F2C5DB;
    color: #1A1A2E;
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #F5E6D3;
    color: #4A4A5A;
  }
  .prose tr:nth-child(even) td {
    background: #FFF8F0;
  }
</style>
