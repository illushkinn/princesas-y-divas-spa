---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Blog / Listado
 * ─────────────────────────────────────────────
 * Listado de posts con filtro por categoría.
 * Categorías: tips, eventos, promociones.
 */

import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/sections/BlogCard.astro";
import Icon from "../../components/ui/Icon.astro";
import { getCollection } from "astro:content";
import { SITE_CONFIG } from "../../data/site-config";

const allPosts = await getCollection("blog");

// Ordenar por fecha descendente
const posts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Categorías disponibles
const categories = [
  { id: "all", label: "Todas" },
  { id: "tips", label: "Tips" },
  { id: "eventos", label: "Eventos" },
  { id: "promociones", label: "Promos" },
];
---

<Layout
  title={`Blog — ${SITE_CONFIG.name}`}
  description="Tips, novedades y todo lo que necesitás saber para el mejor día de spa para tu hija."
>
  <!-- Blog Header -->
  <div class="bg-gradient-to-r from-rose-gold-light via-lavender-light to-rose-gold-light py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
      <Icon name="note" size="3em" class="block mb-4 mx-auto text-rose-functional" aria-hidden="true" />
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-text-primary mb-3">
        Blog
      </h1>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Tips, novedades y todo lo que necesitás saber para el mejor día de spa para tu hija.
      </p>
    </div>
  </div>

  <!-- Filter tabs (estático — sin JS) -->
  <div class="bg-white border-b border-cream-dark/50 sticky top-16 sm:top-20 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
      <nav class="flex flex-wrap gap-2" aria-label="Filtrar por categoría">
        {categories.map((cat) => (
          <a
            href={cat.id === "all" ? "/blog" : `/blog/categoria/${cat.id}`}
            class={`px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 min-h-[44px] inline-flex items-center no-underline ${
              cat.id === "all"
                ? "bg-rose-functional text-white shadow-md"
                : "bg-cream-dark/50 text-text-secondary hover:bg-rose-functional/10 hover:text-rose-functional"
            }`}
            aria-label={`Filtrar por: ${cat.label}`}
          >
            {cat.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Posts grid -->
  <div class="bg-cream py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              slug={post.id.replace(/\.md$/, "")}
              category={post.data.category}
              date={post.data.date.toISOString()}
              excerpt={post.data.excerpt}
              coverImage={post.data.coverImage}
              author={post.data.author}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <Icon name="note" size="4em" class="block mb-4 mx-auto text-rose-functional" aria-hidden="true" />
          <h2 class="text-2xl font-heading font-bold text-text-primary mb-2">
            Próximamente más contenido
          </h2>
          <p class="text-text-secondary mb-6">
            Estamos preparando nuevos artículos para vos.
          </p>
          <a
            href="/"
            class="inline-flex items-center gap-2 text-rose-functional hover:text-rose-functional-hover font-semibold transition-colors duration-200 min-h-[44px]"
          >
            Volver al inicio <Icon name="arrow-right" />
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
