---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Página de Gracias
 * ─────────────────────────────────────────────
 * Redirección post-formulario.
 * Confirmación visual + CTA a WhatsApp.
 */

import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { SITE_CONFIG } from "../data/site-config";

const waLink = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(
  "¡Hola! Acabo de enviar el formulario de reserva. Quería confirmar si lo recibieron."
)}`;
---

<Layout
  title={`Gracias por tu reserva — ${SITE_CONFIG.name}`}
  description="Gracias por contactarnos. Te respondemos en menos de 1 hora."
  noIndex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center bg-gradient-to-br from-rose-gold-light via-cream to-lavender-light">
    <div class="text-center px-4 max-w-lg animate-fade-in-up">
      <div class="mb-6" aria-hidden="true">
        <Icon name="sparkle" size="5em" class="text-rose-gold mx-auto" />
      </div>

      <h1 class="text-3xl sm:text-4xl font-heading font-bold text-text-primary mb-4">
        ¡Gracias por tu reserva!
      </h1>

      <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
        <p class="text-lg text-text-secondary leading-relaxed mb-4">
          Recibimos tu solicitud. Te vamos a responder por WhatsApp
          en menos de <strong>1 hora</strong> para confirmar
          la disponibilidad.
        </p>

        <div class="bg-cream rounded-xl p-4 text-sm text-text-secondary text-left space-y-2">
          <p class="flex items-start gap-2">
            <Icon name="device-mobile" class="mt-0.5" />
            <span>
              <strong>Importante:</strong> Guardá nuestro número
              <strong> {SITE_CONFIG.phoneDisplay} </strong>
              para que no se pierda nuestro mensaje.
            </span>
          </p>
          <p class="flex items-start gap-2">
            <Icon name="clock" class="mt-0.5" />
            <span>Respondemos de lunes a sábados en nuestro horario de atención.</span>
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          variant="whatsapp"
          size="lg"
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          ariaLabel="Confirmar por WhatsApp"
        >
          Confirmanos por WhatsApp
        </Button>

        <Button
          variant="secondary"
          size="lg"
          href="/"
          ariaLabel="Volver al inicio"
        >
          Volver al inicio
        </Button>
      </div>
    </div>
  </div>
</Layout>
