---
/**
 * ─────────────────────────────────────────────
 * Princesas & Divinas — Página 404
 * ─────────────────────────────────────────────
 * Diseño lindo con CTA a home y WhatsApp.
 */

import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { SITE_CONFIG } from "../data/site-config";

const waLink = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(
  "¡Hola! Llegué a una página que no existe en su web y quería consultarles."
)}`;
---

<Layout
  title={`Página no encontrada — ${SITE_CONFIG.name}`}
  description="La página que buscas no existe. Volvé al inicio o consultanos por WhatsApp."
  noIndex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center bg-gradient-to-br from-rose-gold-light via-cream to-lavender-light">
    <div class="text-center px-4 max-w-lg">
      <!-- Ilustración -->
      <div class="mb-6" aria-hidden="true">
        <Icon name="butterfly" size="5em" class="text-rose-gold mx-auto" />
      </div>

      <h1 class="text-4xl sm:text-5xl font-heading font-bold text-text-primary mb-4">
        ¡Ups! Página no encontrada
      </h1>

      <p class="text-lg text-text-secondary mb-8 leading-relaxed">
        Parece que esta página se fue a buscar su corona y no volvió.
        <span class="block mt-2">
          No te preocupes, tenemos muchas cosas lindas para mostrarte.
        </span>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          variant="primary"
          size="lg"
          href="/"
          ariaLabel="Volver al inicio"
        >
          Volver al inicio
        </Button>

        <Button
          variant="whatsapp"
          size="lg"
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          ariaLabel="Consultar por WhatsApp"
        >
          Consultanos por WhatsApp
        </Button>
      </div>
    </div>
  </div>
</Layout>
